#!/usr/bin/env bash
# Source-tree launcher; scientific implementations live in src/qbox.
_qbox_root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
_qbox_loader="$_qbox_root/src/qbox/legacy/load.sh"
if [ ! -f "$_qbox_loader" ]; then
    printf 'qbox: package resources not found: %s\n' "$_qbox_loader" >&2
    if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then return 1; else exit 1; fi
fi

if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    # Compatibility for scripts that source qbox to call its Bash functions.
    source "$_qbox_loader"
else
    # Workstation defaults belong to this checkout, never to the portable package.
    # Load before Python so both legacy menus and direct tasks inherit them.
    if [ -f "$_qbox_root/.qbox-local.sh" ]; then
        source "$_qbox_root/.qbox-local.sh" || exit $?
    fi
    exec bash "$_qbox_root/src/qbox/bin/qbox" "$@"
fi
