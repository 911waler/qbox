  QBOX_QE_ENV_SCRIPT       Optional QE environment script
  QBOX_ONEAPI_ENV_SCRIPT   Optional compiler/MPI environment script
EOF
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    case "${1-}" in
        --help|-h)
            qbox_print_help
            exit 0
            ;;
        --version|-V)
            qbox_print_version
            exit 0
            ;;
    esac

    if [[ "$QBOX_TEST_MODE" != "1" ]]; then
        qe_main "$@"
    fi
fi
