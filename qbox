import re
import sys
from pathlib import Path

import matplotlib as mpl
import matplotlib.pyplot as plt

bands_file = Path(sys.argv[1])
vbm_file = Path(sys.argv[2])
cbm_file = Path(sys.argv[3])
output_prefix = sys.argv[4]
bands_out = Path(sys.argv[5])

mpl.rcParams.update({
    "font.family": "sans-serif",
