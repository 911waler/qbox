			: > hp.element2.in
			: > hp.tot.in
			echo '&INPUTHP' >> hp.element1.in
			echo "   prefix          = '"${prefix}"'" >> hp.element1.in
			echo "   outdir          = './tmp'" >> hp.element1.in
			echo "   iverbosity      = 2" >> hp.element1.in
