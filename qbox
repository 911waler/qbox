echo 
echo ' * 计算 DFT+U+V 时，hp.x 输入文件格式与 DFT+U 相同。'
echo '   运行命令示例：mpirun -np 16 hp.x -i hp.in > hp.out'
echo 
 
PS3=''
hpin_array=("只计算一种元素的 U" "计算两种元素的 U" "返回")
select ihpin in "${hpin_array[@]}"; do
	case $ihpin in 
		"只计算一种元素的 U")
			: > hp.in
