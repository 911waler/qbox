		echo "$mesh" | awk -F '*' 'NF==3 {printf "%d*%d*%d\n", $1*2, $2*2, $3*2}'
	fi
}

function pwin_scale_kpmesh (){
	local mesh="$1"
	local scale="$2"
	if [ "$mesh" == "gamma" ]; then
		echo "gamma"
	else
		echo "$mesh" | awk -F '*' -v s="$scale" 'NF==3 {
			for(i=1;i<=3;i++){
				v=int($i*s)
				if(v < $i*s) v++
				if(v < 1) v=1
				out[i]=v
			}
			printf "%d*%d*%d\n", out[1], out[2], out[3]
		}'
	fi
}

