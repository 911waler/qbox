					if [ -n "$value" ]; then
						if echo "$value" | awk 'NF==1 && $1 ~ /^([0-9]+([.][0-9]*)?|[.][0-9]+)([dDeE][-+]?[0-9]+)?$/ {exit 0} {exit 1}'; then
