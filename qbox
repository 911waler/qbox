		if [ "$nat" -le 20 ]; then
			target=24
		elif [ "$nat" -le 100 ]; then
			target=48
		elif [ "$nat" -le 300 ]; then
			target=96
		elif [ "$nat" -le 800 ]; then
			target=128
		else
			target=192
		fi
	else
		if [ "$nat" -le 20 ]; then
			target=16
		elif [ "$nat" -le 100 ]; then
