function hpin (){
#print how to calculate hubbard U parameters
echo ' 提示：'
echo ' * 非磁性体系：'
echo '  步骤 1：在 pw.x 输入文件中开启 Hubbard U，并为对应元素设置一个非零 U 值，例如 1.D-8。'
