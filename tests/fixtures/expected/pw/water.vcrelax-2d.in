 &CONTROL
   calculation     = 'vc-relax'
   restart_mode    = 'from_scratch'
   outdir          = './tmp'
   pseudo_dir      = '/mock/SSSP'
   prefix          = 'water'
   verbosity       = 'low'
   etot_conv_thr   = 1.D-5
   forc_conv_thr   = 1.D-3
   nstep           = 300
 /
 &SYSTEM
   ibrav           = 0
   nat             = 3
   ntyp            = 2
   ecutwfc         = 35
   ecutrho         = 400
   occupations     = 'fixed'
 /
 &ELECTRONS
   electron_maxstep = 128
   conv_thr        = 1.D-6
   mixing_mode     = 'plain'
   mixing_beta     = 0.7
   mixing_ndim     = 8
   diagonalization = 'david'
   diago_david_ndim = 2
 /
 &IONS
   ion_dynamics    = 'bfgs'
 /
 &CELL
   cell_dynamics   = 'bfgs'
   press           = 0
   press_conv_thr  = 0.5
   cell_dofree     = '2Dxy'
 /
 CELL_PARAMETERS angstrom
     10.000000000    0.000000000    0.000000000
     0.000000000    10.000000000    0.000000000
     0.000000000    0.000000000    10.000000000
 
 ATOMIC_SPECIES
   H 	1.008 	H.UPF
   O 	15.999 	O.UPF
 
 ATOMIC_POSITIONS angstrom
    O      5.000000000    5.000000000    5.000000000
    H      5.570000000    5.000000000    5.000000000
    H      4.810000000    5.540000000    5.000000000
 
 K_POINTS automatic
 3 3 3 0 0 0
