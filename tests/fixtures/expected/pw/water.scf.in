 &CONTROL
   calculation     = 'scf'
   restart_mode    = 'from_scratch'
   outdir          = './tmp'
   pseudo_dir      = '/mock/SSSP'
   prefix          = 'water'
   verbosity       = 'low'
 /
 &SYSTEM
   ibrav           = 0
   nat             = 3
   ntyp            = 2
   ecutwfc         = 35
   ecutrho         = 400
   occupations     = 'fixed'
 /
 &ELECTRONS
   electron_maxstep = 128
   ! 默认 1.D-6 为较粗糙精度；如需更高精度，请改为 1.D-8。
   conv_thr        = 1.D-6
   mixing_mode     = 'plain'
   mixing_beta     = 0.7
   mixing_ndim     = 8
   diagonalization = 'david'
   diago_david_ndim = 2
 /
 CELL_PARAMETERS angstrom
     10.000000000    0.000000000    0.000000000
     0.000000000    10.000000000    0.000000000
     0.000000000    0.000000000    10.000000000
 
 ATOMIC_SPECIES
   H 	1.008 	H.UPF
   O 	15.999 	O.UPF
 
 ATOMIC_POSITIONS angstrom
    O      5.000000000    5.000000000    5.000000000
    H      5.570000000    5.000000000    5.000000000
    H      4.810000000    5.540000000    5.000000000
 
 K_POINTS automatic
 3 3 3 0 0 0
